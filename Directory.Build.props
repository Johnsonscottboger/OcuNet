<Project>
  <PropertyGroup>
    <Copyright>Copyright © Anthony Simmon $([System.DateTime]::UtcNow.ToString(yyyy))</Copyright>
    <Authors>Anthony Simmon</Authors>
    <Owners>Anthony Simmon</Owners>
    <PackageProjectUrl>https://github.com/asimmon/askaiser-marionette</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Description>OcuNet is a test automation framework based on image and text recognition.</Description>
  </PropertyGroup>

  <!--
    Pin a deterministic assembly version for the OcuNet/OcuNet.SourceGenerator
    assemblies. GitVersion (below) otherwise derives AssemblyVersion from the
    repo's commit history (AssemblyVersion = GitVersion_AssemblySemVer), so the
    version drifts between builds. MyAgent.Runtime.dll is compiled against
    whatever version OcuNet.SourceGenerator had at build time, so a version
    change between builds leaves the referencing assembly (e.g. 1.0.1.0) and the
    deployed DLL (e.g. 1.0.0.0) out of sync, producing:
      Could not load file or assembly 'OcuNet.SourceGenerator, Version=1.0.1.0'
    Pinning AssemblyVersion/FileVersion and disabling GitVersion's
    UpdateAssemblyInfo makes the assembly version stable so the reference always
    matches the deployed copy. (The git-derived package/NuGet version is kept for
    OcuNet's own packaging; this only pins the assembly identity.)
  -->
  <PropertyGroup>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <UpdateAssemblyInfo>false</UpdateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.435">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="GitVersion.MsBuild" Version="5.11.1" Condition=" '$(Configuration)' == 'Release' ">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
